{
  "$defs": {
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Assertion Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        }
      },
      "required": [
        "assertion_id",
        "status",
        "expected"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "PASSED",
        "FAILED",
        "ERROR",
        "SKIPPED",
        "INCOMPLETE"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "FailureCategory": {
      "enum": [
        "ASSERTION_FAILURE",
        "PROVIDER_ERROR",
        "ENVIRONMENT_FAILURE",
        "DATA_FAILURE",
        "UNSUPPORTED_BEHAVIOR",
        "UNKNOWN"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "ResultStatus": {
      "enum": [
        "PASSED",
        "FAILED",
        "ERROR",
        "SKIPPED",
        "UNKNOWN"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "status"
      ],
      "title": "StepResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion_results": {
      "items": {
        "$ref": "#/$defs/AssertionResult"
      },
      "title": "Assertion Results",
      "type": "array"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "correlation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "environment_identity": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment Identity",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Execution Id",
      "type": "string"
    },
    "failure_category": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureCategory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "observed_outcomes": {
      "items": {
        "type": "string"
      },
      "title": "Observed Outcomes",
      "type": "array"
    },
    "producer": {
      "default": "autoqe",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "provider_version": {
      "title": "Provider Version",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Fingerprints",
      "type": "object"
    },
    "source_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "step_results": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "title": "Step Results",
      "type": "array"
    },
    "test_data_reset_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Data Reset Identity"
    },
    "test_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Test Id",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "test_id",
    "project_id",
    "provider",
    "provider_version",
    "status",
    "started_at"
  ],
  "title": "ExecutionRecord",
  "type": "object"
}
